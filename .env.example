# DexScan AI - environment configuration (Playbook Part V.3).
# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

TELEGRAM_BOT_TOKEN=
DEFAULT_CHAIN=sol
LOG_LEVEL=INFO

# Provider keys are added here incrementally as later steps introduce each
# provider - uncomment and fill in when you reach that step:
#
# Step 4  - DexScreener (no key required; public API)
# Step 5  - RUGCHECK_API_KEY=
# Step 8  - Holder Engine runs with NO key at all against the free public
#           Solana RPC endpoint by default (SOLANA_PUBLIC_RPC_URL below).
#           HELIUS_API_KEY is optional: Helius's free tier ($0/mo, 1M
#           credits, no card - dashboard.helius.dev) raises the rate
#           limits without changing any code. Leave both unset to run
#           entirely free with zero signup.
# HELIUS_API_KEY=
# SOLANA_PUBLIC_RPC_URL=
# Step 11 (custom roadmap) - additional Solana RPC fallback endpoints,
#           tried in order (Helius, QuickNode, Shyft, public) if an
#           earlier one fails mid-scan. Both optional; the free public
#           endpoint above always remains the guaranteed last resort
#           even with neither set.
# QUICKNODE_RPC_URL=            # your full endpoint URL from the QuickNode dashboard - no template, it's unique per account
# SHYFT_API_KEY=                # shyft.to/get-api-key
# Step 13 - TWITTERAPI_IO_KEY=
